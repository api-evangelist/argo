{
  "opencollection": "1.0.0",
  "info": {
    "name": "Argo CD Applications Info API",
    "version": "v2.x"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Info",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Argo Workflows Argo Get Server Info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://localhost/api/v1/info"
          },
          "docs": "Returns information about the Argo Workflows server including version and managed namespace."
        },
        {
          "info": {
            "name": "Argo Workflows Argo Get Server Version",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://localhost/api/v1/version"
          },
          "docs": "Returns the version of the Argo Workflows server."
        }
      ]
    }
  ],
  "bundled": true
}