{
  "opencollection": "1.0.0",
  "info": {
    "name": "Argo CD Applications Version API",
    "version": "v2.x"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Version",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Argo CD Argo Get Server Version",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://localhost/api/v1/version"
          },
          "docs": "Returns the Argo CD server version, build date, Git commit SHA, Go version, and Kubernetes server version."
        }
      ]
    }
  ],
  "bundled": true
}