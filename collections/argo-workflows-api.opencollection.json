{
  "opencollection": "1.0.0",
  "info": {
    "name": "Argo CD Applications Workflows API",
    "version": "v2.x"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Workflows",
