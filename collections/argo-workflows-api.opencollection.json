                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name of the workflow"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retries a failed or errored workflow."
        },
        {
          "info": {
            "name": "Argo Workflows Argo Resubmit a Workflow",
            "type": "http"
