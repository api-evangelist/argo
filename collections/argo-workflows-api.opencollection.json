            "url": "https://localhost/api/v1/workflows/:namespace/:name/terminate",
            "params": [
              {
                "name": "namespace",
                "value": "",
                "type": "path",
                "description": "Kubernetes namespace"
              },
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name of the workflow"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Terminates a running workflow immediately."
        },
        {
          "info": {
            "name": "Argo Workflows Argo Get Workflow Logs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://localhost/api/v1/workflows/:namespace/:name/log",
            "params": [
              {
                "name": "namespace",
                "value": "",
                "type": "path",
                "description": "Kubernetes namespace"
              },
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name of the workflow"
              },
              {
                "name": "podName",
                "value": "",
                "type": "query",
                "description": "Name of the pod to get logs from"
              },
              {
                "name": "logOptions.container",
                "value": "",
                "type": "query",
                "description": "Container name to get logs from"
              },
              {
                "name": "logOptions.follow",
                "value": "",
                "type": "query",
                "description": "Follow the log stream"
              },
              {
                "name": "logOptions.sinceSeconds",
                "value": "",
                "type": "query",
