            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://localhost/api/v1/workflows/:namespace",
            "params": [
              {
                "name": "namespace",
                "value": "",
                "type": "path",
                "description": "Kubernetes namespace"
              },
              {
                "name": "listOptions.labelSelector",
                "value": "",
                "type": "query",
                "description": "Label selector to filter workflows"
              },
              {
                "name": "listOptions.fieldSelector",
                "value": "",
                "type": "query",
                "description": "Field selector to filter workflows"
              },
              {
                "name": "listOptions.limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of workflows to return"
              },
              {
                "name": "listOptions.continue",
                "value": "",
                "type": "query",
                "description": "Continue token for pagination"
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "Fields to include in the response"
              }
            ]
          },
          "docs": "Returns a list of workflows in the specified namespace."
        },
        {
          "info": {
            "name": "Argo Workflows Argo Create a Workflow",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://localhost/api/v1/workflows/:namespace",
            "params": [
              {
                "name": "namespace",
                "value": "",
                "type": "path",
                "description": "Kubernetes namespace"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new workflow in the specified namespace."
        },
